  "keywords": [
    "laravel",
    "rabbitmq",
    "events",
    "microservices",
    "messaging",
    "amqp",
    "pubsub",
    "broadcast",
    "protobuf",
    "event-driven",
    "queue",
    "publish"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Eugene Kirdzei",
      "email": "masterjus@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
